# Copy to docker/.env (git-ignored) and fill in. install_offline.sh writes it for you.
GEOINFER_DB_PASSWORD=change-me
GEOINFER_DATA=/home/USER/geo-data/service      # inbox/, outputs/, scratch/
GEOINFER_MODELS=/mnt/d/geo/models/service      # make service-models
GEOINFER_TAG=dev
GEOINFER_PORT=8000
GEOINFER_GPU=0                                 # device id; on the server use 1
GEOINFER_UID=1000
GEOINFER_GID=1000
